+        assert_eq!(ordinal(&f, 131, Some(100)), None);
+        assert_eq!(ordinal(&f, 100 + 30 * 39, Some(100)), Some(39));
+        assert_eq!(ordinal(&f, 100 + 30 * 40, Some(100)), None);
+        assert_eq!(frame_of(&f, Some(100), 39), Some(100 + 30 * 39));
+        let l = Frames::List(vec![900, 901, 930]);
+        assert_eq!(ordinal(&l, 901, None), Some(1));
