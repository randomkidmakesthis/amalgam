+/// (D1, `VICTORY_PLACED_UAV`) An unordered access view of a texture the title placed in
+/// memory itself, as a view of the resource made for that memory: the same resource
+/// [`placed_texture`] gives its shader views (`crate::resource::texture_at`, keyed by
+/// address and description). `None` with the switch off and for buffers.
+pub(crate) fn placed_unordered_texture(view: &View) -> Option<View> {
+    const BUFFER: u32 = 1;
+    let View::Placed(true, resource, desc) = view else {
+        return None;
+    };
+    // Word 12: the resource flags; without the unordered access one (4) the host copy has
+    // none either (it is filled from title memory), and the view stays null.
+    const UNORDERED: u32 = 4;
+    if resource[0] == BUFFER || resource[12] & UNORDERED == 0 || !crate::silent::placed_uav() {
+        return None;
+    }
+    let address = u64::from(desc[10]) | u64::from(desc[11]) << 32;
+    let texture = crate::resource::texture_at(address, resource)?;
+    Some(View::Unordered(texture as usize, 0, desc[..10].try_into().ok()))
+}
