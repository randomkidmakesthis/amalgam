+++ D1/crates/victory-gpu/src/silent.rs	2026-11-26 09:44:29.632572600 +0200
@@ -0,0 +1,318 @@
+//! (D1, docs/silent-defects-audit.md) Counters of the places where the layer hands
+//! shaders zeros or altered bits without a word, and the switches of their fixes. The
+//! counters are always on (a relaxed add each) and go out with the periodic frame line
+//! ([`line`]), per frame over its period.
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+/// Indices into [`C`].
+pub(crate) mod k {
+    /// A draw tested a depth plane whose twin this list's shaders wrote, before the pass
+    /// that draws the twin into the plane (finding C4): the test saw the plane as it was.
+    pub const DEPTH_LATE: usize = 0;
+    /// Of those, the plane brought up to date at that first use (`VICTORY_DEPTH_TWIN_SYNC`).
+    pub const DEPTH_SYNCED: usize = 1;
+    /// Binds (a draw's or dispatch's table entry) of an unordered view of a texture the
+    /// title placed in memory itself (finding B1).
+    pub const PLACED_UAV_BINDS: usize = 2;
+    /// Host slots made for such views: mirrored (`VICTORY_PLACED_UAV`).
+    pub const PLACED_UAV_MADE: usize = 3;
+    /// Host slots left null for such views (switch off, no texture, or a view the host
+    /// does not allow).
+    pub const PLACED_UAV_NULL: usize = 4;
+    /// Shader views made in another format of the texture's family where one side is sRGB
+    /// and the other not: the read lacks (or adds) the sRGB conversion (finding A7).
+    pub const SRGB_LOST: usize = 5;
+    /// Of those views, made in their sRGB format on a typeless host copy
+    /// (`VICTORY_SRGB_VIEWS`).
+    pub const SRGB_KEPT: usize = 6;
+    /// Constant buffer views made whose host address is not on 256 bytes (finding B4):
+    /// null, they read zeros.
+    pub const CBV_UNALIGNED: usize = 7;
+    /// Of those, served by an aligned copy of their own bytes (`VICTORY_CBV_OWN_COPY`).
+    pub const CBV_OWN: usize = 8;
+    /// Unordered views of placed textures at address 0: the title's null views (null here
+    /// too, as on the console; run 98: every view of finding B1 was one).
+    pub const PLACED_UAV_ZERO: usize = 9;
+    pub const COUNT: usize = 10;
+}
+
+/// The counters, since the last [`line`].
+pub(crate) static C: [AtomicU64; k::COUNT] = [const { AtomicU64::new(0) }; k::COUNT];
+
+pub(crate) fn add(i: usize, n: u64) {
+    C[i].fetch_add(n, Relaxed);
+}
+
+fn switch(name: &str, default: bool) -> bool {
+    match std::env::var(name) {
+        Ok(v) => v.trim() == "1",
+        Err(_) => default,
+    }
+}
+
+/// `VICTORY_PLACED_UAV` (default 1; =0: such views left null, as before): an unordered
+/// view of a texture the title placed in memory is made on the resource made for that
+/// memory, the one its shader views read ([`crate::descriptor::host::placed_texture`]), so
+/// what shaders store there is what later reads of the texture find, as on the console.
+pub(crate) fn placed_uav() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| switch("VICTORY_PLACED_UAV", true))
+}
+
+/// `VICTORY_DEPTH_TWIN_SYNC` (default 0; =1 on): a draw that tests a depth plane whose
+/// twin this list's shaders wrote first has the twin drawn into the plane, at that draw
+/// (the title's state is set again after the pass); off, the plane is drawn when the list
+/// closes and the draw tests the plane as it was.
+pub(crate) fn depth_twin_sync() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| switch("VICTORY_DEPTH_TWIN_SYNC", false))
+}
+
+/// `VICTORY_SRGB_VIEWS` (default 0; =1 on): plain textures (no target, depth or unordered
+/// access) in a UNORM format with an sRGB twin get a typeless host copy, so a shader view
+/// in the sRGB format is made in it and reads with the conversion, as on the console.
+pub(crate) fn srgb_views() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| switch("VICTORY_SRGB_VIEWS", false))
+}
+
+/// `VICTORY_CBV_OWN_COPY` (default 0; =1 on): a constant buffer view not on 256 bytes of
+/// its host copy is made on a copy of its own bytes (which starts on 256), filled from
+/// title memory when the view is made (not per list: later changes without a new write of
+/// the slot are not seen); off, it is null and reads zeros, as before.
+pub(crate) fn cbv_own_copy() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| switch("VICTORY_CBV_OWN_COPY", false))
+}
+
+/// UNORM formats with an sRGB twin, and the twin: R8G8B8A8, BC1, BC2, BC3, B8G8R8A8,
+/// B8G8R8X8, BC7.
+pub(crate) const SRGB_PAIRS: [(u32, u32); 7] = [(28, 29), (71, 72), (74, 75), (77, 78), (87, 91), (88, 93), (98, 99)];
+
+/// Whether a view in `view` of a typed texture in `own` (same family) changes the sRGB
+/// conversion: one of them sRGB, the other not.
+pub(crate) fn srgb_differs(view: u32, own: u32) -> bool {
+    let srgb = |f: u32| SRGB_PAIRS.iter().any(|&(_, s)| s == f);
+    view != own && srgb(view) != srgb(own)
+}
+
+/// The typeless format a host copy in `format` takes for [`srgb_views`]: a UNORM format of
+/// [`SRGB_PAIRS`] (or its sRGB twin) becomes its family's typeless one.
+pub(crate) fn srgb_typeless(format: u32) -> Option<u32> {
+    SRGB_PAIRS
+        .iter()
+        .any(|&(l, s)| l == format || s == format)
+        .then(|| crate::resource::family(format))
+        .filter(|&t| t != format)
+}
+
+/// Distinct placed textures (by address) bound through unordered views in this period;
+/// and the ones described so far (the first few are logged with format and size).
+static PLACED_SEEN: Mutex<Option<std::collections::HashSet<u64>>> = Mutex::new(None);
+static DESCRIBED: AtomicU64 = AtomicU64::new(0);
+
+/// A placed texture at `address` (resource description words `resource`) was bound or
+/// made through an unordered view; `mirrored` whether its host slot shows it.
+pub(crate) fn placed_uav_seen(address: u64, resource: &[u32; 14], mirrored: bool) {
+    if address == 0 {
+        return;
+    }
+    let new = PLACED_SEEN
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get_or_insert_with(Default::default)
+        .insert(address);
+    if new && DESCRIBED.fetch_add(1, Relaxed) < 8 {
+        tracing::info!(
+            address = format_args!("{address:#x}"),
+            dimension = resource[0],
+            width = resource[4],
+            height = resource[6],
+            depth_or_layers = resource[7] & 0xffff,
+            levels = resource[7] >> 16,
+            format = resource[8],
+            flags = format_args!("{:#x}", resource[12]),
+            mirrored,
+            "unordered view of a texture the title placed in memory (first few; VICTORY_PLACED_UAV)"
+        );
+    }
+}
+
+/// `VICTORY_DISPATCH_SIZES=1` (default 0): the thread groups of the direct dispatches of
+/// the programs in [`SIZED`] are summed per period and logged with [`line`] (indirect
+/// dispatches have their sizes on the card only, and are not seen here).
+pub(crate) fn dispatch_sizes() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| switch("VICTORY_DISPATCH_SIZES", false))
+}
+
+/// The programs whose dispatch sizes are logged (docs/heavy-passes.md: ray binning, shadow
+/// masks), as hash prefixes in their pipeline's name.
+const SIZED: [&str; 2] = ["cb6adcc6da2613ff", "5cf00dc39042edaf"];
+
+/// Per program of [`SIZED`], this period: dispatches, groups, fewest and most groups in
+/// one, and up to four distinct shapes.
+#[derive(Default)]
+struct Sized {
+    dispatches: u64,
+    groups: u64,
+    least: u64,
+    most: u64,
+    shapes: Vec<[u32; 3]>,
+    /// Indirect: dispatches, the groups of their first record as title memory held it
+    /// when recorded, records that were not readable, the most records one asked for, and
+    /// how many had a count in a buffer.
+    indirect: u64,
+    indirect_groups: u64,
+    unread: u64,
+    max_records: u32,
+    counted: u64,
+}
+
+/// By pipeline object: which of [`SIZED`] it runs (looked up once); then the sums.
+#[allow(clippy::type_complexity)]
+static SIZES: Mutex<Option<(std::collections::HashMap<usize, Option<usize>>, [Sized; 2])>> = Mutex::new(None);
+
+/// Which of [`SIZED`] pipeline `pipeline` (named `name`) runs, with the sums.
+fn sized_of<R>(pipeline: usize, name: &str, f: impl FnOnce(&mut Sized) -> R) -> Option<R> {
+    let mut sizes = SIZES.lock().unwrap_or_else(|e| e.into_inner());
+    let (which, sums) = sizes.get_or_insert_with(Default::default);
+    let k = (*which.entry(pipeline).or_insert_with(|| {
+        let name = name.to_ascii_lowercase();
+        SIZED.iter().position(|h| name.contains(h))
+    }))?;
+    Some(f(&mut sums[k]))
+}
+
+/// An indirect dispatch by pipeline `pipeline` named `name`: its first record's groups
+/// as read now (`None`: not readable), the most records it may run, whether a buffer
+/// holds their count.
+pub(crate) fn dispatch_size_indirect(pipeline: usize, name: &str, groups: Option<[u32; 3]>, max: u32, counted: bool) {
+    sized_of(pipeline, name, |s| {
+        s.indirect += 1;
+        s.max_records = s.max_records.max(max);
+        s.counted += u64::from(counted);
+        match groups {
+            Some(g) => {
+                s.indirect_groups += g.iter().map(|&n| u64::from(n)).product::<u64>();
+                if s.shapes.len() < 4 && !s.shapes.contains(&g) {
+                    s.shapes.push(g);
+                }
+            }
+            None => s.unread += 1,
+        }
+    });
+}
+
+/// A direct dispatch of `groups` by pipeline `pipeline` named `name`.
+pub(crate) fn dispatch_size(pipeline: usize, name: &str, groups: [u32; 3]) {
+    sized_of(pipeline, name, |s| direct(s, groups));
+}
+
+fn direct(s: &mut Sized, groups: [u32; 3]) {
+    let n = groups.iter().map(|&g| u64::from(g)).product::<u64>();
+    s.least = if s.dispatches == 0 { n } else { s.least.min(n) };
+    s.most = s.most.max(n);
+    s.dispatches += 1;
+    s.groups += n;
+    if s.shapes.len() < 4 && !s.shapes.contains(&groups) {
+        s.shapes.push(groups);
+    }
+}
+
+/// The dispatch sizes' line ([`dispatch_sizes`]), per frame over `frames`.
+fn sizes_line(frames: f64) {
+    let mut sizes = SIZES.lock().unwrap_or_else(|e| e.into_inner());
+    let Some((_, sums)) = sizes.as_mut() else {
+        tracing::info!("dispatch sizes (VICTORY_DISPATCH_SIZES=1): none of {SIZED:?} dispatched directly this period");
+        return;
+    };
+    for (k, s) in sums.iter_mut().enumerate() {
+        let s = std::mem::take(s);
+        let per = |n: u64| n as f64 / frames.max(1.0);
+        tracing::info!(
+            "dispatch sizes (VICTORY_DISPATCH_SIZES=1) {}: {:.1} direct dispatches per frame, {:.0} thread groups per \
+             frame, {} to {} groups each; {:.1} indirect per frame ({} with a count buffer, up to {} records), first \
+             records as title memory held them when recorded {:.0} groups per frame ({} not readable); shapes {:?}",
+            SIZED[k],
+            per(s.dispatches),
+            per(s.groups),
+            s.least,
+            s.most,
+            per(s.indirect),
+            s.counted,
+            s.max_records,
+            per(s.indirect_groups),
+            s.unread,
+            s.shapes
+        );
+    }
+}
+
+/// The counters' line, per frame over `frames`, and the period starts again.
+pub(crate) fn line(frames: f64) {
+    if dispatch_sizes() {
+        sizes_line(frames);
+    }
+    let c: [u64; k::COUNT] = std::array::from_fn(|i| C[i].swap(0, Relaxed));
+    let distinct = PLACED_SEEN
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .as_mut()
+        .map_or(0, |s| std::mem::take(s).len());
+    let f = |i: usize| c[i] as f64 / frames.max(1.0);
+    let on = |b: bool| u8::from(b);
+    tracing::info!(
+        "silent defects per frame: depth planes used (tested, read, copied) before their twin's writes reached them {:.2}, \
+         brought up to date at that use {:.2} (VICTORY_DEPTH_TWIN_SYNC={}); unordered views of placed textures: \
+         {:.1} binds, {distinct} distinct textures this period, {:.2} slots mirrored, {:.2} left null, \
+         {:.2} the title's null views (address 0) (VICTORY_PLACED_UAV={}); shader views whose sRGB conversion differs from the texture's {:.2} made, \
+         {:.2} sRGB views on typeless copies (VICTORY_SRGB_VIEWS={}); title-slot constant buffer views not on 256 \
+         bytes {:.2} made, {:.2} of them on an own copy, the rest null (tables a draw reads them through are made \
+         afresh, aligned; these slots are read only past a table's used entries or picked by index) \
+         (VICTORY_CBV_OWN_COPY={})",
+        f(k::DEPTH_LATE),
+        f(k::DEPTH_SYNCED),
+        on(depth_twin_sync()),
+        f(k::PLACED_UAV_BINDS),
+        f(k::PLACED_UAV_MADE),
+        f(k::PLACED_UAV_NULL),
+        f(k::PLACED_UAV_ZERO),
+        on(placed_uav()),
+        f(k::SRGB_LOST),
+        f(k::SRGB_KEPT),
+        on(srgb_views()),
+        f(k::CBV_UNALIGNED),
+        f(k::CBV_OWN),
+        on(cbv_own_copy()),
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn srgb_pairs_tell_conversion_changes() {
+        assert!(srgb_differs(29, 28));
+        assert!(srgb_differs(28, 29));
+        assert!(srgb_differs(72, 71));
+        assert!(srgb_differs(99, 98));
+        assert!(!srgb_differs(28, 28));
+        // Both linear (UNORM and UINT views of one family): no conversion either way.
+        assert!(!srgb_differs(30, 28));
+    }
+
+    #[test]
+    fn srgb_typeless_is_the_family() {
+        assert_eq!(srgb_typeless(28), Some(27));
+        assert_eq!(srgb_typeless(29), Some(27));
+        assert_eq!(srgb_typeless(71), Some(70));
+        assert_eq!(srgb_typeless(98), Some(97));
+        assert_eq!(srgb_typeless(87), Some(90));
+        assert_eq!(srgb_typeless(88), Some(92));
+        assert_eq!(srgb_typeless(2), None);
+    }
+}
