+/// view's slot word in the strides table ([`victory_shader::emit::VIEW_INTEGER`],
+/// `VIEW_SIGNED`): 0 for float, normalised, raw and structured views, and for anything
+/// that is not a buffer view.
+pub(crate) fn view_kind_bits(view: &View) -> u32 {
+    let Some((_, _, _, stride, _, raw, _)) = buffer_fields(view) else {
+        return 0;
+    };
+    let words: &[u32] = match view {
+        View::Shader(_, Some(d)) | View::Unordered(_, _, Some(d)) => &d[..],
+        View::Placed(_, _, d) => &d[..10],
+        _ => return 0,
+    };
+    if stride != 0 || raw {
+        return 0;
+    }
+    integer_kind(words[0])
+}
+
+/// The kind bits of DXGI format `format`: unsigned or signed integer, or 0.
+fn integer_kind(format: u32) -> u32 {
+    use victory_shader::emit::{VIEW_INTEGER, VIEW_SIGNED};
+    match format {
+        3 | 7 | 12 | 17 | 25 | 30 | 36 | 42 | 50 | 57 | 62 => VIEW_INTEGER,
+        4 | 8 | 14 | 18 | 32 | 38 | 43 | 52 | 59 | 64 => VIEW_INTEGER | VIEW_SIGNED,
+        _ => 0,
+    }
+}
