+    /// A wave64 compute program counting s2 from 0 by 1 while it differs
+    /// from `bound` (`s_cmp_lg_u32 s2, <bound>`: a 32-bit literal, or s4, a
+    /// copy of the group id), adding 1 to v1 each time, then storing v1.
+    fn counting(bound: Option<u32>) -> NativeProgram {
+        // s_mov_b32 s4, s1; s_mov_b32 s1, 0; s_load_dwordx4 s[8:11], s[0:1], 0;
+        // s_mov_b32 s2, 0; v_mov_b32 v1, 0
+        let mut words = vec![
+            0xBE84_0301,
+            0xBE81_0380,
+            0xF408_0200,
+            0xFA00_0000,
+            0xBE82_0380,
+            0x7E02_0280,
+        ];
+        // v_add_nc_u32 v1, 1, v1; s_add_i32 s2, s2, 1
+        words.extend_from_slice(&[0x4A02_0281, 0x8102_8102]);
+        match bound {
+            // s_cmp_lg_u32 s2, lit; s_cbranch_scc1 (to the v_add)
+            Some(k) => words.extend_from_slice(&[0xBF07_FF02, k, 0xBF85_FFFB]),
+            // s_cmp_lg_u32 s2, s4; s_cbranch_scc1
+            None => words.extend_from_slice(&[0xBF07_0402, 0xBF85_FFFC]),
+        }
+        // v_lshlrev_b32 v3, 2, v0; buffer_store_dword v1, v3, s[8:11], 0 offen; s_endpgm
+        words.extend_from_slice(&[0x3406_0082, 0xE070_1000, 0x8002_0103, 0xBF81_0000]);
+        NativeProgram {
+            stage: HwStage::Cs,
+            wave64: true,
+            vgprs: 4,
+            layout: vec![RootParam {
+                root: RootType::Table,
+                table_offset_dwords: 0,
+                sgprs: 1,
+                base_register: 0,
+                user_data: 0,
+                slot: 0,
+            }],
+            used: vec![UsedResource {
+                kind: ResourceType::Uav,
+                root: RootType::Table,
+                table_offset_dwords: 0,
+                lower_bound: 0,
+                stride: 0,
+                dwords: 4,
+                user_data: 0,
+                slot: 0,
+            }],
+            io: StageIo::Cs(ComputeIo {
+                // one user SGPR, then the group id x (s1)
+                rsrc2: 2 | 1 << 7,
+                threads: [64, 1, 1],
+            }),
+            code: words.iter().flat_map(|w| w.to_le_bytes()).collect(),
+        }
+    }
+
+    /// The caps the translation of `native` emits, with `limits` as the
+    /// stage caps.
+    fn emitted_caps(native: &NativeProgram, limits: StageLimits) -> Vec<u32> {
+        let p = ir::build(&native.patched_code(), native.wave64, native.vgprs).unwrap();
+        let res = resource::track(&p, &native.layout, native.stage, None).unwrap();
+        let io = io::raise(&p, native).unwrap();
+        let st = structure::structure(&p).unwrap();
+        let container = crate::dxbc::build(&[]);
+        let c = Container::parse(&container).unwrap();
+        TEST_LIMITS.with(|t| t.set(Some(limits)));
+        CHOSEN.with(|c| c.borrow_mut().clear());
+        let r = super::super::emit(&c, native, &p, &st, &io, &res);
+        TEST_LIMITS.with(|t| t.set(None));
+        r.unwrap();
+        let mut chosen = CHOSEN.with(|c| c.take());
+        assert!(!chosen.is_empty(), "no loop counted");
+        // (one per form the translation tried)
+        chosen.dedup();
+        chosen
+    }
+
+    /// The loop's cap as `cap_with` decides it for `class`.
+    fn cap_of(
+        native: &NativeProgram,
+        class: Class,
+        traces: bool,
+        limits: StageLimits,
+    ) -> (u32, Option<&'static str>) {
+        let p = ir::build(&native.patched_code(), native.wave64, native.vgprs).unwrap();
+        let mut rpo = vec![usize::MAX; p.blocks.len()];
+        for (n, b) in crate::ir::reverse_postorder(&p.blocks)
+            .into_iter()
+            .enumerate()
+        {
+            rpo[b] = n;
+        }
+        let (h, q) = (0..p.blocks.len())
+            .flat_map(|h| p.blocks[h].preds.iter().map(move |&q| (h, q)))
+            .find(|&(h, q)| rpo[h] <= rpo[q])
+            .expect("a loop");
+        cap_with(&p, &rpo, h, q, class, traces, LOOP_LIMIT, limits)
+    }
+
+    /// A counted loop of 10,000 runs was cut at 4,096 in compute; now it
+    /// gets the compute cap, and one of 100,000 its own bound.
+    #[test]
+    fn a_counted_loop_is_not_cut_short() {
+        let d = StageLimits::DEFAULT;
+        assert_eq!(emitted_caps(&counting(Some(10_000)), d), [COMPUTE_DEFAULT]);
+        assert_eq!(emitted_caps(&counting(Some(100_000)), d), [100_000]);
+        assert_eq!(
+            cap_of(&counting(Some(100_000)), Class::Compute, false, d),
+            (100_000, None)
+        );
+        // (a pixel or geometry one too: its bound, over the stage cap)
+        assert_eq!(
+            cap_of(&counting(Some(1000)), Class::Pixel, false, d),
+            (1000, None)
+        );
+        assert_eq!(
+            cap_of(&counting(Some(1000)), Class::Geometry, false, d),
+            (1000, None)
+        );
+        // Past 2^20 runs (here 2^32, wrapping) it is not proven.
+        assert_eq!(
+            cap_of(&counting(Some(0)), Class::Compute, false, d),
+            (COMPUTE_DEFAULT, Some(LONG))
+        );
+    }
