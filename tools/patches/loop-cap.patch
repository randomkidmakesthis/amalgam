diff --git a/crates/victory-shader/src/emit/loop_cap.rs b/crates/victory-shader/src/emit/loop_cap.rs
new file mode 100644
index 0000000..812e7bd
--- /dev/null
+++ b/crates/victory-shader/src/emit/loop_cap.rs
@@ -0,0 +1,725 @@
+//! Loop caps: after how many iterations a translated loop is left, per lane
+//! and per entry into the loop ([`super::lower`]'s counters). The console
+//! runs a loop as long as its data says; data the host has not mirrored yet
+//! can make that billions of iterations, which hangs the host GPU until
+//! Windows resets the driver, so every loop has a cap:
+//! - a loop proven to stop by itself ([`counted`]) gets its own bound (when
+//!   above the stage's cap): it can never reach it;
+//! - any other loop gets its stage's cap: pixel [`PIXEL_DEFAULT`], vertex
+//!   and mesh [`GEOMETRY_DEFAULT`], compute [`COMPUTE_DEFAULT`], and a
+//!   program that tests rays against tree nodes (`image_bvh*`, outside the
+//!   pixel and geometry stages) [`TRACE_LOOP_LIMIT`], whatever the switches
+//!   say;
+//! - with the `diagnostics` feature, `VICTORY_SHADER_LOOP_LIMIT`
+//!   ([`super::loop_limit`]) names one cap for every loop, as before.
+//!
+//! The stage caps are switches in every build: `VICTORY_LOOP_LIMIT_PIXEL`,
+//! `VICTORY_LOOP_LIMIT_GEOMETRY` (vertex and mesh) and
+//! `VICTORY_LOOP_LIMIT_COMPUTE`, decimal or `0x` hex, read once, clamped to
+//! [`MIN_CAP`]..=[`LOOP_LIMIT`]; unset, unreadable or 0 is the default. They
+//! change the translation: the shader cache keys on them (the names are in
+//! `VICTORY_SHADER_SWITCHES`, the values in [`super::translation_fingerprint`]).
+//!
+//! A lane at the cap leaves the loop: through the loop's exit when the back
+//! edge is a branch, as killed (a pixel discards) when it is a jump.
+//! [`capped_loops`] lists a program's loops that can be cut so, for the log.
+
+use std::sync::OnceLock;
+
+use super::lower::{LOOP_LIMIT, TRACE_LOOP_LIMIT};
+use crate::gfx10::{Fields, NULL, Operand};
+use crate::ir::{Exit, Inst, Program, Reg, Value};
+use crate::native::HwStage;
+use crate::{Container, FourCC, ShaderError};
+
+/// The pixel cap. (It was 1,024: the opening cutscene lost the card 14-25
+/// frames in; see `count_iteration`.)
+pub const PIXEL_DEFAULT: u32 = 1 << 7;
+/// The vertex and mesh cap (it was 4,096).
+pub const GEOMETRY_DEFAULT: u32 = 1 << 8;
+/// The compute cap. It was 4,096, which a data-parallel kernel's per-lane
+/// loop over a long axis can pass: a 64-thread reduction over more than
+/// 2^18 elements was cut and its output left unwritten (the title's
+/// `compute_graph_ops:CS_Reduce*`). 2^16 covers 2^22 elements a 64-thread
+/// group and 2^26 a 1,024-stride copy (`CS_FormulaOperation`);
+/// compute was 65,536 before (the card losses then were in a minimap or
+/// shadow mesh draw). A runaway lane still stops, 16 times later than at
+/// 4,096.
+pub const COMPUTE_DEFAULT: u32 = 1 << 16;
+/// The smallest cap a switch can set.
+pub const MIN_CAP: u32 = 16;
+
+/// The stages with a cap of their own.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Class {
+    Pixel,
+    /// Vertex and mesh.
+    Geometry,
+    Compute,
+}
+
+impl Class {
+    pub(super) fn of(pixel: bool, geometry: bool) -> Self {
+        match (pixel, geometry) {
+            (true, _) => Class::Pixel,
+            (false, true) => Class::Geometry,
+            (false, false) => Class::Compute,
+        }
+    }
+
+    fn of_stage(stage: HwStage) -> Self {
+        Class::of(
+            stage == HwStage::Ps,
+            matches!(stage, HwStage::Vs | HwStage::Ms),
+        )
+    }
+}
+
+/// The stage caps in effect.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct StageLimits {
+    pub pixel: u32,
+    pub geometry: u32,
+    pub compute: u32,
+}
+
+impl StageLimits {
+    pub const DEFAULT: StageLimits = StageLimits {
+        pixel: PIXEL_DEFAULT,
+        geometry: GEOMETRY_DEFAULT,
+        compute: COMPUTE_DEFAULT,
+    };
+}
+
+/// The stage caps: the defaults, or what the switches say (read once).
+pub fn stage_limits() -> StageLimits {
+    static LIMITS: OnceLock<StageLimits> = OnceLock::new();
+    *LIMITS.get_or_init(|| {
+        let var = |name: &str| std::env::var(name).ok();
+        StageLimits {
+            pixel: parse_cap(var("VICTORY_LOOP_LIMIT_PIXEL").as_deref(), PIXEL_DEFAULT),
+            geometry: parse_cap(
+                var("VICTORY_LOOP_LIMIT_GEOMETRY").as_deref(),
+                GEOMETRY_DEFAULT,
+            ),
+            compute: parse_cap(
+                var("VICTORY_LOOP_LIMIT_COMPUTE").as_deref(),
+                COMPUTE_DEFAULT,
+            ),
+        }
+    })
+}
+
+/// A stage switch's value: `default` when unset, unreadable or 0, else
+/// clamped to [`MIN_CAP`]..=[`LOOP_LIMIT`]. Pure, for testing.
+fn parse_cap(value: Option<&str>, default: u32) -> u32 {
+    let parsed = value
+        .map(str::trim)
+        .and_then(|v| match v.strip_prefix("0x") {
+            Some(hex) => u32::from_str_radix(hex, 16).ok(),
+            None => v.parse().ok(),
+        });
+    match parsed {
+        Some(n) if n > 0 => n.clamp(MIN_CAP, LOOP_LIMIT),
+        _ => default,
+    }
+}
+
+#[cfg(test)]
+thread_local! {
+    /// Tests: stage caps instead of the switches', and the caps chosen.
+    pub(super) static TEST_LIMITS: std::cell::Cell<Option<StageLimits>> = const { std::cell::Cell::new(None) };
+    pub(super) static CHOSEN: std::cell::RefCell<Vec<u32>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// The cap of the loop that `latch`'s back edge to `header` closes, and
+/// why it is not a bound the loop is proven to stay under (`None`: it is).
+pub(super) fn cap(
+    p: &Program,
+    rpo: &[usize],
+    header: usize,
+    latch: usize,
+    class: Class,
+    traces: bool,
+) -> (u32, Option<&'static str>) {
+    let limits = stage_limits();
+    #[cfg(test)]
+    let limits = TEST_LIMITS.with(|t| t.get()).unwrap_or(limits);
+    let r = cap_with(
+        p,
+        rpo,
+        header,
+        latch,
+        class,
+        traces,
+        super::loop_limit(),
+        limits,
+    );
+    #[cfg(test)]
+    CHOSEN.with(|c| c.borrow_mut().push(r.0));
+    r
+}
+
+#[allow(clippy::too_many_arguments)]
+fn cap_with(
+    p: &Program,
+    rpo: &[usize],
+    header: usize,
+    latch: usize,
+    class: Class,
+    traces: bool,
+    all: u32,
+    limits: StageLimits,
+) -> (u32, Option<&'static str>) {
+    if all != LOOP_LIMIT {
+        return (
+            all,
+            Some("VICTORY_SHADER_LOOP_LIMIT names the cap of every loop"),
+        );
+    }
+    let stage = match class {
+        Class::Pixel => limits.pixel,
+        Class::Geometry => limits.geometry,
+        // (while the title's tree builder is off, a walk can follow garbage)
+        Class::Compute if traces => TRACE_LOOP_LIMIT,
+        Class::Compute => limits.compute,
+    };
+    match counted(p, rpo, header, latch) {
+        Ok(runs) => (runs.max(stage), None),
+        Err(why) => (stage, Some(why)),
+    }
+}
+
+const LANES: &str = "a per-lane loop, no scalar compare closes its back edge";
+const BACK_EDGES: &str = "it has more than one back edge";
+const COUNTER: &str = "its compare is not of a counter stepped by a constant";
+const START: &str = "its counter does not start at a constant";
+const MEMORY: &str = "its bound is read from memory";
+const COMPUTED: &str = "its bound is computed";
+const GIVEN: &str = "its bound is user data or a system value";
+const LONG: &str = "its constant bound is past 2^20 iterations";
+
+/// The times the body of a counted loop runs, at most: a loop whose only back
+/// edge, from `latch` to `header`, is a branch on the SCC of an `s_cmp_*_{u32,i32}`
+/// of a header phi stepped by a constant (`s_add`/`s_sub`) with a constant,
+/// the phi starting at the same constant from every way in. Other exits only
+/// shorten it. The count is the console's, wrapping included (run step by
+/// step, up to [`LOOP_LIMIT`]). Err: why the loop is not one.
+pub(super) fn counted(
+    p: &Program,
+    rpo: &[usize],
+    header: usize,
+    latch: usize,
+) -> Result<u32, &'static str> {
+    let reachable = |b: usize| rpo.get(b).is_some_and(|&n| n != usize::MAX);
+    let preds = &p.blocks[header].preds;
+    if preds
+        .iter()
+        .filter(|&&q| reachable(q) && rpo[header] <= rpo[q])
+        .count()
+        != 1
+    {
+        return Err(BACK_EDGES);
+    }
+    let Exit::Branch { taken, not_taken } = p.blocks[latch].exit else {
+        return Err(LANES);
+    };
+    let branch = p.blocks[latch].insts.last().ok_or(LANES)?;
+    let on_set = match branch.name() {
+        "s_cbranch_scc1" => true,
+        "s_cbranch_scc0" => false,
+        _ => return Err(LANES),
+    };
+    // The back edge is taken while SCC is `go`.
+    let go = match (taken == header, not_taken == header) {
+        (true, false) => on_set,
+        (false, true) => !on_set,
+        _ => return Err(LANES),
+    };
+    let defs = definitions(p);
+    let cmp = defs
+        .get(&branch.read(Reg::Scc).ok_or(LANES)?)
+        .copied()
+        .ok_or(LANES)?;
+    let (op, signed) = compare(cmp.name()).ok_or(COUNTER)?;
+    let Fields::Sop { src, .. } = &cmp.fields else {
+        return Err(COUNTER);
+    };
+    let [a, b] = src.as_slice() else {
+        return Err(COUNTER);
+    };
+    let (next, bound, swapped) = match (term(cmp, a).ok_or(COUNTER)?, term(cmp, b).ok_or(COUNTER)?)
+    {
+        (Err(v), Ok(k)) => (v, k, false),
+        (Ok(k), Err(v)) => (v, k, true),
+        (Err(x), Err(y)) => {
+            // The counter is the stepped one; the other side says why.
+            let mut other = if step(&defs, x).is_some() { y } else { x };
+            // (through copies)
+            while let Some(i) = defs.get(&other).filter(|i| i.name() == "s_mov_b32")
+                && let Fields::Sop { src, .. } = &i.fields
+                && let [s] = src.as_slice()
+                && let Some(Err(v)) = term(i, s)
+            {
+                other = v;
+            }
+            let read = defs
+                .get(&other)
+                .is_some_and(|i| matches!(i.fields, Fields::Smem { .. }));
+            let given = p.inputs.iter().any(|&(_, v)| v == other);
+            return Err(if read {
+                MEMORY
+            } else if given {
+                GIVEN
+            } else {
+                COMPUTED
+            });
+        }
+        (Ok(_), Ok(_)) => return Err(COUNTER),
+    };
+    let (phi, delta) = step(&defs, next).ok_or(COUNTER)?;
+    let phi = p.blocks[header]
+        .phis
+        .iter()
+        .find(|f| f.value == phi)
+        .ok_or(COUNTER)?;
+    let mut start = None;
+    for (&q, &arg) in preds.iter().zip(&phi.args) {
+        if !reachable(q) {
+            continue;
+        }
+        if q == latch {
+            if arg != next {
+                return Err(COUNTER);
+            }
+            continue;
+        }
+        let k = defs.get(&arg).and_then(|i| constant_move(i)).ok_or(START)?;
+        if start.replace(k).is_some_and(|s| s != k) {
+            return Err(START);
+        }
+    }
+    let mut x = start.ok_or(START)?;
+    for runs in 1..=LOOP_LIMIT {
+        x = x.wrapping_add(delta);
+        let (l, r) = if swapped { (bound, x) } else { (x, bound) };
+        if holds(op, signed, l, r) != go {
+            return Ok(runs);
+        }
+    }
+    Err(LONG)
+}
+
+/// The instruction writing each value.
+fn definitions(p: &Program) -> std::collections::HashMap<Value, &Inst> {
+    p.blocks
+        .iter()
+        .flat_map(|b| &b.insts)
+        .flat_map(|i| i.writes.iter().map(move |w| (w.1, i)))
+        .collect()
+}
+
+/// A one-dword scalar operand: its constant, or the value it reads.
+fn term(inst: &Inst, op: &Operand) -> Option<Result<u32, Value>> {
+    match *op {
+        Operand::Scalar { code: NULL, .. } => Some(Ok(0)),
+        Operand::Scalar { code, dwords: 1 } => inst.read(Reg::S(code)).map(Err),
+        Operand::Const(c) => crate::resource::inline(c).map(Ok),
+        Operand::Literal(x) => Some(Ok(x)),
+        _ => None,
+    }
+}
+
+/// `v` as a value stepped by a constant: the stepped value and the step.
+fn step(defs: &std::collections::HashMap<Value, &Inst>, v: Value) -> Option<(Value, u32)> {
+    let inst = defs.get(&v)?;
+    let Fields::Sop { src, .. } = &inst.fields else {
+        return None;
+    };
+    let [a, b] = src.as_slice() else { return None };
+    let (a, b) = (term(inst, a)?, term(inst, b)?);
+    match (inst.name(), a, b) {
+        ("s_add_i32" | "s_add_u32", Err(x), Ok(k)) | ("s_add_i32" | "s_add_u32", Ok(k), Err(x)) => {
+            Some((x, k))
+        }
+        ("s_sub_i32" | "s_sub_u32", Err(x), Ok(k)) => Some((x, k.wrapping_neg())),
+        _ => None,
+    }
+}
+
+/// The constant an `s_mov_b32` of one writes.
+fn constant_move(inst: &Inst) -> Option<u32> {
+    let Fields::Sop { src, .. } = &inst.fields else {
+        return None;
+    };
+    match (inst.name(), src.as_slice()) {
+        ("s_mov_b32", [k]) => term(inst, k)?.ok(),
+        _ => None,
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Op {
+    Eq,
+    Ne,
+    Lt,
+    Le,
+    Gt,
+    Ge,
+}
+
+/// An `s_cmp_*` of dwords: the relation and whether it is signed.
+fn compare(name: &str) -> Option<(Op, bool)> {
+    let rest = name.strip_prefix("s_cmp_")?;
+    let (rel, ty) = rest.split_once('_')?;
+    let signed = match ty {
+        "i32" => true,
+        "u32" => false,
+        _ => return None,
+    };
+    let op = match rel {
+        "eq" => Op::Eq,
+        "lg" => Op::Ne,
+        "lt" => Op::Lt,
+        "le" => Op::Le,
+        "gt" => Op::Gt,
+        "ge" => Op::Ge,
+        _ => return None,
+    };
+    Some((op, signed))
+}
+
+fn holds(op: Op, signed: bool, l: u32, r: u32) -> bool {
+    let ord = if signed {
+        (l as i32).cmp(&(r as i32))
+    } else {
+        l.cmp(&r)
+    };
+    match op {
+        Op::Eq => ord.is_eq(),
+        Op::Ne => ord.is_ne(),
+        Op::Lt => ord.is_lt(),
+        Op::Le => ord.is_le(),
+        Op::Gt => ord.is_gt(),
+        Op::Ge => ord.is_ge(),
+    }
+}
+
+/// A loop that can be left at its cap.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CappedLoop {
+    /// Byte offset of the loop header's first instruction.
+    pub offset: usize,
+    pub cap: u32,
+    /// Why the loop is not proven to stay under it.
+    pub why: &'static str,
+}
+
+/// The stage of `container`'s vertex, pixel, compute or mesh program and its
+/// loops that can be left at their cap (every loop but the counted ones
+/// under it, as [`cap`] decides for the translation; found on the program
+/// as built, before the translation's other forms of it).
+pub fn capped_loops(container: &[u8]) -> Result<(HwStage, Vec<CappedLoop>), ShaderError> {
+    let c = Container::parse(container)?;
+    let dxil = c
+        .part(FourCC::DXIL)
+        .ok_or(ShaderError::Malformed("no DXIL part"))?;
+    let native = crate::native_programs(dxil.data)?
+        .into_iter()
+        .find(|p| {
+            matches!(
+                p.stage,
+                HwStage::Vs | HwStage::Ps | HwStage::Cs | HwStage::Ms
+            )
+        })
+        .ok_or(ShaderError::Malformed(
+            "no vertex, pixel, compute or mesh program",
+        ))?;
+    let p = crate::spill::build(&native)?;
+    Ok((
+        native.stage,
+        capped_loops_of(&p, Class::of_stage(native.stage)),
+    ))
+}
+
+fn capped_loops_of(p: &Program, class: Class) -> Vec<CappedLoop> {
+    let mut rpo = vec![usize::MAX; p.blocks.len()];
+    for (n, b) in crate::ir::reverse_postorder(&p.blocks)
+        .into_iter()
+        .enumerate()
+    {
+        rpo[b] = n;
+    }
+    let traces = p
+        .blocks
+        .iter()
+        .any(|b| b.insts.iter().any(|i| i.name().starts_with("image_bvh")));
+    let mut out = Vec::new();
+    for (h, block) in p.blocks.iter().enumerate() {
+        for &q in block
+            .preds
+            .iter()
+            .filter(|&&q| rpo[h] != usize::MAX && rpo[q] != usize::MAX && rpo[h] <= rpo[q])
+        {
+            if let (cap, Some(why)) = cap(p, &rpo, h, q, class, traces) {
+                out.push(CappedLoop {
+                    offset: block.offset,
+                    cap,
+                    why,
+                });
+            }
+        }
+    }
+    out.sort_by_key(|l| l.offset);
+    out
+}
