+    /// The switches are in the shader cache's key: their names in the
+    /// switch list (each one's value goes into the fingerprint), the caps
+    /// in effect too.
+    #[test]
+    fn the_fingerprint_keys_on_the_cap_switches() {
+        let names: Vec<&str> = env!("VICTORY_SHADER_SWITCHES").split(',').collect();
+        for name in [
+            "VICTORY_LOOP_LIMIT_COMPUTE",
+            "VICTORY_LOOP_LIMIT_PIXEL",
+            "VICTORY_LOOP_LIMIT_GEOMETRY",
+            "VICTORY_SHADER_LOOP_LIMIT",
+        ] {
+            assert!(names.contains(&name), "{name}");
+        }
+        // (read before the switch is set, so no test takes it for its cap)
+        let _ = stage_limits();
+        let before = super::super::translation_fingerprint();
+        // SAFETY: nothing in this crate reads the variable after
+        // `stage_limits` has (above); Windows' environment calls are
+        // thread-safe.
+        unsafe { std::env::set_var("VICTORY_LOOP_LIMIT_COMPUTE", "12345") };
+        let set = super::super::translation_fingerprint();
+        unsafe { std::env::remove_var("VICTORY_LOOP_LIMIT_COMPUTE") };
+        assert_ne!(before, set);
+        assert_eq!(before, super::super::translation_fingerprint());
+    }
