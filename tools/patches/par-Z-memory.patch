+        mb(used),
+        mb(budget),
+        mb(high),
+        mb(low),
+        mb(KINDS[1].load(Relaxed) + crate::tiles::given_total()),
+        LRU[0].load(Relaxed),
+        mb(LRU[1].load(Relaxed)),
+        mb(room_now),
+        mb(room_since),
+        mb(again_now),
+        mb(again_since),
+        mb(LRU[6].load(Relaxed)),
+        alive,
+        draining,
+        TEXTURES_MADE[3].load(Relaxed),
+        DRAINED[1].load(Relaxed),
