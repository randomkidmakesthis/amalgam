+/// `VICTORY_WINDOW_IDLE_S` (20; 0: the idle time of the PC's other caches,
+/// `crate::host::ram_idle_ms`, as before).
+fn window_idle_s() -> u64 {
+    static S: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
