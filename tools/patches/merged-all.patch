+    /// `memory[i] = value` for the first `count` dwords.
+    const FILL: &str = r#"
+#define RS "RootConstants(num32BitConstants=2, b0), UAV(u0)"
+cbuffer What : register(b0) { uint value; uint count; };
+RWByteAddressBuffer memory : register(u0);
+[RootSignature(RS)]
+[numthreads(64, 1, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    if (id.x < count) {
+        memory.Store(id.x * 4u, value);
+    }
+}
+"#;
+
+    /// On the software adapter (`VICTORY_D3D12_WARP=1`, diagnostics): a
+    /// program writes a pattern into a host copy; the probe's copies on the
+    /// card see it before and after, title memory has it once the list has
+    /// run, and three rounds come out changing, then identical.
+    #[test]
+    fn warp_probe_sees_a_dispatchs_writes_change_then_stay() {
+        use windows_sys::Win32::System::Memory::{
+            MEM_COMMIT, MEM_RESERVE, PAGE_READWRITE, VirtualAlloc,
+        };
+        const MEM_WRITE_WATCH: u32 = 0x0020_0000;
+        let Some(host) = crate::host::host() else {
+            return;
+        };
+        // The host device is the software adapter exactly then (`host.rs`).
+        if std::env::var_os("VICTORY_D3D12_WARP").is_none() {
+            eprintln!(
+                "probe tests: skipped, the host device is not the software adapter (VICTORY_D3D12_WARP=1, diagnostics)"
+            );
+            return;
+        }
+        const LEN: usize = 1 << 20;
+        const COUNT: u32 = 256;
+        // SAFETY: a plain allocation of our own.
+        let title = unsafe {
+            VirtualAlloc(
+                std::ptr::null(),
+                LEN,
+                MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH,
+                PAGE_READWRITE,
+            )
+        } as *mut u8;
+        assert!(!title.is_null());
+        crate::shadow::register(0x9_0b0e, title as u64, LEN as u64);
+        let shadow = crate::shadow::find(title as u64, LEN as u64).expect("a host copy");
+        let code =
+            crate::host::compile(FILL, windows::core::s!("main"), windows::core::s!("cs_5_1"))
+                .expect("the test's shader");
+        // SAFETY: the shader's own root signature; plain creation.
+        let (root, pso): (ID3D12RootSignature, ID3D12PipelineState) = unsafe {
+            let device = host.device();
+            let root: ID3D12RootSignature = device
+                .CreateRootSignature(0, &code)
+                .expect("a root signature");
+            let pso = device
+                .CreateComputePipelineState(&D3D12_COMPUTE_PIPELINE_STATE_DESC {
+                    pRootSignature: std::mem::transmute_copy(&root),
+                    CS: D3D12_SHADER_BYTECODE {
+                        pShaderBytecode: code.as_ptr().cast(),
+                        BytecodeLength: code.len(),
+                    },
+                    ..Default::default()
+                })
+                .expect("a pipeline");
+            (root, pso)
+        };
+        FORCED.store(true, Ordering::Relaxed);
+        let name = "warp_probe_fill";
+        let address = title as u64 + 0x1000;
+        let bytes = u64::from(COUNT) * 4;
+        for (k, value) in [7u32, 9, 9].into_iter().enumerate() {
+            let list = host.new_list().expect("a host list");
+            shadow.refresh(&list, address, bytes);
+            shadow.gpu_writes(&list, address, bytes);
+            let meta = Meta {
+                frame: 1_000_000 + k as u64,
+                sample: k as u32,
+                order: 0,
+                hash: "0000000000000000".to_owned(),
+                name: name.to_owned(),
+                indirect: false,
+                groups: [COUNT / 64, 1, 1],
+                records: 1,
+                parts: false,
+            };
+            let view = ViewIn {
+                reg: "u0".to_owned(),
+                slot: 1,
+                entry: 0,
+                write: true,
+                kind: "root-view",
+                address,
+                len: bytes,
+                source: Source::Card(shadow.clone()),
+            };
+            let probed = begin(&list, meta, vec![view], 1 << 20, u64::MAX);
+            assert!(probed.is_some());
+            // SAFETY: an open list; the copy's buffer; the shader's own
+            // root signature.
+            unsafe {
+                list.list.SetComputeRootSignature(&root);
+                list.list.SetPipelineState(&pso);
+                list.list
+                    .SetComputeRoot32BitConstants(0, 2, [value, COUNT].as_ptr().cast(), 0);
+                list.list
+                    .SetComputeRootUnorderedAccessView(1, shadow.gpu(address));
+                list.list.Dispatch(COUNT / 64, 1, 1);
+            }
+            after(probed, &list);
+            list.close();
+            host.execute(&[&list]);
+            crate::host::settle_for_fence();
+            // Title memory has what the program wrote.
+            // SAFETY: inside the allocation.
+            assert_eq!(
+                unsafe {
+                    (address as *const u32)
+                        .add(COUNT as usize - 1)
+                        .read_volatile()
+                },
+                value
+            );
+        }
+        let summary = lock(&SUMMARY);
+        let line = &summary.as_ref().expect("a summary")[&(name.to_owned(), "u0".to_owned(), true)];
+        eprintln!(
+            "{} (host copy in the card's memory: {})",
+            line_text(name, "u0", true, line),
+            shadow.carded()
+        );
+        assert_eq!(
+            (line.first, line.changing, line.identical, line.zero),
+            (1, 1, 1, 0)
+        );
+        assert_eq!(line.nonzero, vec![u64::from(COUNT); 3]);
+        // The third round wrote what was there: unchanged by it. Title
+        // memory always had the card's bytes.
+        assert_eq!((line.untouched, line.differs), (1, 0));
+        FORCED.store(false, Ordering::Relaxed);
+    }
+}
