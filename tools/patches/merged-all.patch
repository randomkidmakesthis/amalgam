+        if std::env::var_os("VICTORY_HEAP_DRAIN").is_none() {
+            assert!(!super::drain_on() && !super::drain_evict_on());
+        }
+    }
+
+    #[test]
+    fn the_low_mark_is_never_over_the_high_one() {
+        assert_eq!(marks_of(85, 75), (85, 75));
+        assert_eq!(marks_of(70, 80), (70, 70));
+    }
+
