+/// Whether the console's sampler descriptions are given host bounds
+/// (`VICTORY_SAMPLER_SANITISE=0`: as they come, as before). On by default
+/// (allforks e7c125c): a sampler without a mip filter samples level 0 only
+/// (MinLOD = MaxLOD = 0, where it took the console's minimum LOD, so a
+/// sampler with a minimum of 3 read a smaller level than the console);
+/// NaN and infinite LODs, a maximum under the minimum, a bias past the
+/// host's range and address modes the host does not have are made
+/// valid; the comparison function of a sampler that does not compare is
+/// "never" (comparison samplers, the shadow maps', keep theirs).
+fn sanitised() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_SAMPLER_SANITISE").is_none_or(|v| v != "0"))
+}
