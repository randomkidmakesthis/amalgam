+    #[test]
+    fn probe_zero_identical_changing() {
+        let a = stats(&floats(&[1.0, 2.0]));
+        let b = stats(&floats(&[1.0, 3.0]));
+        let z = stats(&floats(&[0.0, 0.0]));
+        assert_eq!(classify(None, &a), Class::First);
+        assert_eq!(classify(Some(a.hash), &a), Class::Identical);
+        assert_eq!(classify(Some(a.hash), &b), Class::Changing);
+        // Zero first, whatever came before.
+        assert_eq!(classify(Some(z.hash), &z), Class::Zero);
+        assert_eq!(classify(None, &z), Class::Zero);
+        let l = Line {
+            len: 64,
+            frames: [0, 1, 2].into_iter().collect(),
+            zero: 1,
+            identical: 1,
+            changing: 0,
+            first: 1,
