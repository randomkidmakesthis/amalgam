+    #[test]
+    fn probe_float_statistics() {
+        let s = stats(&floats(&[
+            0.0,
+            1.0,
+            -2.0,
+            f32::NAN,
+            f32::INFINITY,
+            0.0,
+            4.0,
+        ]));
+        assert_eq!(s.nonzero, 5);
+        assert_eq!(s.nonfinite, 2);
+        assert_eq!((s.min, s.max), (Some(-2.0), Some(4.0)));
+        assert_eq!(s.mean, Some(3.0 / 5.0));
+        assert!(!s.zero);
+        assert_eq!(s.bytes, 28);
+        let z = stats(&[0u8; 64]);
+        assert!(z.zero);
+        assert_eq!(
+            (z.nonzero, z.min, z.max, z.mean),
+            (0, Some(0.0), Some(0.0), Some(0.0))
+        );
+        // A byte past the last dword counts for zero, not for the floats.
+        let mut tail = vec![0u8; 9];
+        tail[8] = 1;
+        let t = stats(&tail);
+        assert!(!t.zero && t.nonzero == 0);
+        // Negative zero is a non-zero dword.
+        assert_eq!(stats(&floats(&[-0.0])).nonzero, 1);
+        let e = stats(&[]);
+        assert!(e.zero && e.min.is_none() && e.mean.is_none());
+        // The hash: the first 16 hex digits of BLAKE3.
+        let bytes = floats(&[1.0, 2.0]);
+        assert_eq!(
+            format!("{:016x}", stats(&bytes).hash),
+            blake3::hash(&bytes).to_hex()[..16]
+        );
+    }
