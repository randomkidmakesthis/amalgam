+/// The register `r` of `ctx` (CONTEXT order: rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi, r8..r15).
+fn register(ctx: &mut CONTEXT, r: u8) -> &mut u64 {
+    match r & 15 {
+        0 => &mut ctx.Rax,
+        1 => &mut ctx.Rcx,
+        2 => &mut ctx.Rdx,
+        3 => &mut ctx.Rbx,
+        4 => &mut ctx.Rsp,
