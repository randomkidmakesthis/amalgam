diff -ruN '--exclude=target' F1base/crates/victory-hle/src/readback.rs F1/crates/victory-hle/src/readback.rs
--- F1base/crates/victory-hle/src/readback.rs	1970-01-01 02:00:00.000000000 +0200
+++ F1/crates/victory-hle/src/readback.rs	2026-11-26 01:01:40.380999100 +0200
@@ -0,0 +1,157 @@
+//! The hooks of finding F1 in the title's code (build 1.0.2.1; addresses
+//! as RVAs from the preferred base 0x140000000): the ring of read-back
+//! buffers (`victory_gpu::readback`), and with `VICTORY_READBACK_LOCKS=1`
+//! the engine's generic buffer lock. Each site's bytes are checked first;
+//! a site that differs is left alone with a warning.
+
+use std::cell::RefCell;
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+
+use victory_loader::callhook::{self, Regs};
+
+/// The `call` (5 bytes) in the read-back ring's constructor that runs once
+/// its buffers exist, with rcx = rsi = the ring (`mov rcx, rsi` before it).
+const RING_SITE: usize = 0x1adc33b;
+/// What it calls.
+const RING_TARGET: usize = 0x1adc380;
+/// The title's alias of CPU memory for the GPU: start, length, GPU base.
+const ALIAS: u64 = 0x9e1dac0;
+/// The generic buffer lock (rcx = buffer handle, rdx = lock record), and
+/// its first instructions: `push rsi; push rdi; push rbx; sub rsp, 0x20`.
+const LOCK: usize = 0x5121550;
+const LOCK_PROLOGUE: [u8; 7] = [0x56, 0x57, 0x53, 0x48, 0x83, 0xEC, 0x20];
+/// Its unlock (rcx = the same record): `mov r8, rcx; mov rcx, [rcx+0x10]`.
+const UNLOCK: usize = 0x4e8abe0;
+const UNLOCK_PROLOGUE: [u8; 7] = [0x49, 0x89, 0xC8, 0x48, 0x8B, 0x49, 0x10];
+/// The return address of the constructor's one call, in the ring wrapper
+/// (0x141d40f90: eight pushes and 0x68 bytes, then the call).
+const CTOR_RETURN: usize = 0x1d4107d;
+/// From the hook's return slot to the constructor's return address (its
+/// five pushes and 0x50 bytes, the call's own slot), and from there to the
+/// wrapper's return address.
+const TO_CTOR_RETURN: usize = 0x80;
+const TO_WRAPPER_RETURN: usize = 0xb0;
+/// Where the wrapper returns to, for the rings named so far (the 22 call
+/// sites are all in the log by address).
+const NAMED: [(usize, &str); 3] =
+    [(0xcc9067, "imposter"), (0x1dfee58, "visibility_buffer"), (0x3286358, "terrain_virtual_texture")];
+/// The preferred base, for addresses printed as the analyst's.
+const PREFERRED: u64 = 0x1_4000_0000;
+
+static BASE: AtomicU64 = AtomicU64::new(0);
+static AFTER: AtomicUsize = AtomicUsize::new(0);
+
+thread_local! {
+    /// Locks under way on this thread: the real return address, the
+    /// record, the handle.
+    static LOCKS: RefCell<Vec<(u64, u64, u64)>> = const { RefCell::new(Vec::new()) };
+}
+
+unsafe extern "C" fn ring_made(regs: *mut Regs) {
+    // SAFETY: the thunk's saved registers.
+    let ring = unsafe { (*regs).rcx } as usize;
+    let base = BASE.load(Ordering::Relaxed) as usize;
+    // The stack above the call, as the constructor and the wrapper laid it
+    // out (checked by the constructor's return address).
+    // SAFETY: `ret` is the call's slot on this thread's stack; the frames
+    // above it are the constructor's and the wrapper's, still live.
+    let slot = unsafe { std::ptr::addr_of!((*regs).ret) } as usize;
+    let ctor_return = unsafe { ((slot + TO_CTOR_RETURN) as *const usize).read() };
+    let site = if ctor_return == base + CTOR_RETURN {
+        // SAFETY: as above.
+        unsafe { ((slot + TO_CTOR_RETURN + TO_WRAPPER_RETURN) as *const usize).read() }.wrapping_sub(base)
+    } else {
+        0
+    };
+    let name = NAMED.iter().find(|n| n.0 == site).map_or("", |n| n.1);
+    let site = if site == 0 { 0 } else { site as u64 + PREFERRED };
+    let alias = base as u64 + ALIAS;
+    let _ = std::panic::catch_unwind(|| victory_gpu::readback::ring_created(ring, alias, site, name));
+}
+
+unsafe extern "C" fn lock_entered(regs: *mut Regs) {
+    // SAFETY: the thunk's saved registers; `ret` is the return address on
+    // the stack, which the stub takes.
+    let regs = unsafe { &mut *regs };
+    if regs.rdx == 0 {
+        return;
+    }
+    let caller = regs.ret.wrapping_sub(BASE.load(Ordering::Relaxed)).wrapping_add(PREFERRED);
+    let (handle, record, r8, r9) = (regs.rcx, regs.rdx, regs.r8, regs.r9);
+    let _ = std::panic::catch_unwind(|| victory_gpu::readback::lock_entered(handle, record, r8, r9, caller));
+    LOCKS.with(|l| l.borrow_mut().push((regs.ret, record, handle)));
+    regs.ret = AFTER.load(Ordering::Relaxed) as u64;
+}
+
+unsafe extern "C" fn unlock_entered(regs: *mut Regs) {
+    // SAFETY: the thunk's saved registers.
+    let record = unsafe { (*regs).rcx };
+    let _ = std::panic::catch_unwind(|| victory_gpu::readback::unlocked(record));
+}
+
+unsafe extern "C" fn lock_returned(rax: u64, slot: *mut u64) {
+    let Some((ret, record, handle)) = LOCKS.with(|l| l.borrow_mut().pop()) else {
+        // Nowhere to return to: cannot happen (each stub return was pushed).
+        std::process::abort();
+    };
+    // SAFETY: the stub's slot for the return address.
+    unsafe { *slot = ret };
+    let caller = ret.wrapping_sub(BASE.load(Ordering::Relaxed)).wrapping_add(PREFERRED);
+    let _ = std::panic::catch_unwind(|| victory_gpu::readback::lock_returned(handle, record, caller, rax & 0xff != 0));
+}
+
+/// The bytes at `rva` of the image at `base`.
+fn bytes(base: usize, rva: usize, n: usize) -> Vec<u8> {
+    // SAFETY: inside the mapped image (the sites are in its .text).
+    unsafe { std::slice::from_raw_parts((base + rva) as *const u8, n) }.to_vec()
+}
+
+/// Installs the hooks the switches ask for into the image at `base`.
+///
+/// # Safety
+/// `base` is the title's mapped image (build 1.0.2.1 or one whose bytes the
+/// checks refuse), and no title code runs yet.
+pub unsafe fn install(base: usize) {
+    if !victory_gpu::readback::set_on() {
+        return;
+    }
+    BASE.store(base as u64, Ordering::Relaxed);
+    // The call and the `mov rcx, rsi` before it.
+    let found = bytes(base, RING_SITE - 3, 8);
+    if found[..3] != [0x48, 0x89, 0xF1] {
+        tracing::warn!(at = format_args!("{:#x}", base + RING_SITE), found = ?found, "read-back ring hook not installed: the bytes differ (another build?)");
+        return;
+    }
+    // SAFETY: the caller's promise; `redirect_call` checks the call.
+    match unsafe { callhook::redirect_call(base + RING_SITE, base + RING_TARGET, ring_made) } {
+        Ok(()) => tracing::info!(at = format_args!("{:#x}", base + RING_SITE), "read-back ring hook installed (VICTORY_READBACK_SET=1)"),
+        Err(e) => {
+            tracing::warn!(error = %e, "read-back ring hook not installed: the bytes differ (another build?)");
+            return;
+        }
+    }
+    if !victory_gpu::readback::locks_on() {
+        return;
+    }
+    let stub = match callhook::after_stub(lock_returned) {
+        Ok(stub) => stub,
+        Err(e) => {
+            tracing::warn!(error = %e, "buffer lock hook not installed");
+            return;
+        }
+    };
+    AFTER.store(stub, Ordering::Relaxed);
+    // SAFETY: the caller's promise; `hook_entry` checks the prologue.
+    match unsafe { callhook::hook_entry(base + LOCK, &LOCK_PROLOGUE, lock_entered) } {
+        Ok(()) => tracing::info!(at = format_args!("{:#x}", base + LOCK), "buffer lock hook installed (VICTORY_READBACK_LOCKS=1)"),
+        Err(e) => {
+            tracing::warn!(error = %e, "buffer lock hook not installed: the bytes differ (another build?)");
+            return;
+        }
+    }
+    // SAFETY: as above.
+    match unsafe { callhook::hook_entry(base + UNLOCK, &UNLOCK_PROLOGUE, unlock_entered) } {
+        Ok(()) => tracing::info!(at = format_args!("{:#x}", base + UNLOCK), "buffer unlock hook installed (VICTORY_READBACK_LOCKS=1)"),
+        Err(e) => tracing::warn!(error = %e, "buffer unlock hook not installed: the bytes differ (another build?)"),
+    }
+}
diff -ruN '--exclude=target' F1base/crates/victory-loader/src/callhook.rs F1/crates/victory-loader/src/callhook.rs
--- F1base/crates/victory-loader/src/callhook.rs	1970-01-01 02:00:00.000000000 +0200
+++ F1/crates/victory-loader/src/callhook.rs	2026-11-26 00:37:12.061882800 +0200
@@ -0,0 +1,318 @@
+//! Small hooks in the title's code: a `call rel32` redirected to a thunk
+//! (call-site redirect), or a function entry turned into a jump to one
+//! (entry hook). Same mechanism as the static TLS redirect (`crate::tls`):
+//! generated code on a page within `rel32` reach of the image, the title's
+//! bytes rewritten while no title code runs, after checking them.
+//!
+//! The thunk saves every volatile register, the flags and xmm0-5, calls a
+//! routine of ours with a pointer to the saved general registers
+//! ([`Regs`]), restores everything, runs the bytes it replaced (an entry
+//! hook's prologue; nothing for a call site) and jumps on to the original
+//! code: the title sees the same registers, flags and stack as without it.
+//! The routine runs on a 16-byte aligned stack with its shadow space.
+//!
+//! A routine may replace [`Regs::ret`] (the return address of the call
+//! being made) with an [`after_stub`]: the function then returns there,
+//! the stub calls a second routine with the function's `rax` and a slot to
+//! put the real return address in, and returns there with `rax` and xmm0
+//! as the function left them.
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use anyhow::{Result, bail};
+use windows_sys::Win32::System::Diagnostics::Debug::FlushInstructionCache;
+use windows_sys::Win32::System::Memory::{PAGE_EXECUTE_READ, PAGE_EXECUTE_READWRITE, VirtualProtect};
+use windows_sys::Win32::System::Threading::GetCurrentProcess;
+
+/// The general registers as the thunk saved them, lowest address first;
+/// `ret` is the return address on the stack (writable: see the module).
+#[repr(C)]
+#[derive(Debug, Clone, Copy)]
+pub struct Regs {
+    pub r11: u64,
+    pub r10: u64,
+    pub r9: u64,
+    pub r8: u64,
+    pub rdx: u64,
+    pub rcx: u64,
+    pub rax: u64,
+    pub flags: u64,
+    pub ret: u64,
+}
+
+/// Called before the hooked code, with the saved registers.
+pub type Before = unsafe extern "C" fn(*mut Regs);
+/// Called when a function whose return an [`after_stub`] took returns:
+/// its `rax`, and the slot to write the real return address into.
+pub type After = unsafe extern "C" fn(u64, *mut u64);
+
+/// Whether `code` (5 bytes at address `site`) is `call target`.
+pub fn is_call_to(code: &[u8], site: usize, target: usize) -> bool {
+    code.len() >= 5
+        && code[0] == 0xE8
+        && (site as i64 + 5 + i64::from(i32::from_le_bytes([code[1], code[2], code[3], code[4]]))) as usize == target
+}
+
+/// The thunk: saves, calls `before`, restores, runs `replaced`, jumps to
+/// `resume`. Position independent.
+fn before_thunk(before: usize, replaced: &[u8], resume: usize) -> Vec<u8> {
+    let mut c = vec![0x9C, 0x50, 0x51, 0x52, 0x41, 0x50, 0x41, 0x51, 0x41, 0x52, 0x41, 0x53];
+    c.extend([0x48, 0x81, 0xEC, 0x88, 0, 0, 0]); // sub rsp, 0x88
+    for x in 0..6u8 {
+        c.extend([0xF3, 0x0F, 0x7F, 0x44 | x << 3, 0x24, 0x20 + 0x10 * x]); // movdqu [rsp+..], xmmN
+    }
+    c.extend([0x48, 0x8D, 0x8C, 0x24, 0x88, 0, 0, 0]); // lea rcx, [rsp+0x88]: the saved registers
+    c.extend([0x48, 0xB8]);
+    c.extend((before as u64).to_le_bytes()); // mov rax, before
+    c.extend([0xFF, 0xD0]); // call rax
+    for x in 0..6u8 {
+        c.extend([0xF3, 0x0F, 0x6F, 0x44 | x << 3, 0x24, 0x20 + 0x10 * x]); // movdqu xmmN, [rsp+..]
+    }
+    c.extend([0x48, 0x81, 0xC4, 0x88, 0, 0, 0]); // add rsp, 0x88
+    c.extend([0x41, 0x5B, 0x41, 0x5A, 0x41, 0x59, 0x41, 0x58, 0x5A, 0x59, 0x58, 0x9D]);
+    c.extend(replaced);
+    c.extend([0xFF, 0x25, 0, 0, 0, 0]); // jmp [rip]
+    c.extend((resume as u64).to_le_bytes());
+    c
+}
+
+/// The stub a function returns to when a [`Before`] routine took its
+/// return ([`after_stub`]).
+fn after_code(after: usize) -> Vec<u8> {
+    let mut c = vec![0x48, 0x83, 0xEC, 0x08, 0x50, 0x48, 0x83, 0xEC, 0x30]; // sub rsp,8; push rax; sub rsp,0x30
+    c.extend([0xF3, 0x0F, 0x7F, 0x44, 0x24, 0x20]); // movdqu [rsp+0x20], xmm0
+    c.extend([0x48, 0x89, 0xC1, 0x48, 0x8D, 0x54, 0x24, 0x38]); // mov rcx, rax; lea rdx, [rsp+0x38]
+    c.extend([0x48, 0xB8]);
+    c.extend((after as u64).to_le_bytes());
+    c.extend([0xFF, 0xD0]); // call rax
+    c.extend([0xF3, 0x0F, 0x6F, 0x44, 0x24, 0x20]); // movdqu xmm0, [rsp+0x20]
+    c.extend([0x48, 0x83, 0xC4, 0x30, 0x58, 0xC3]); // add rsp,0x30; pop rax; ret
+    c
+}
+
+/// Our code on a fresh page near `near_to`, made executable.
+fn place(near_to: usize, code: &[u8]) -> Result<usize> {
+    if code.len() > 4096 {
+        bail!("hook thunk too large");
+    }
+    let page = crate::tls::near(near_to, 0)?;
+    // SAFETY: a fresh writable page of ours, 4096 bytes.
+    unsafe { std::ptr::copy_nonoverlapping(code.as_ptr(), page, code.len()) };
+    let mut old = 0;
+    // SAFETY: our page.
+    if unsafe { VirtualProtect(page as _, 4096, PAGE_EXECUTE_READ, &mut old) } == 0 {
+        bail!("VirtualProtect(hook thunk) failed: {}", std::io::Error::last_os_error());
+    }
+    Ok(page as usize)
+}
+
+/// Writes `bytes` over the code at `at`.
+///
+/// # Safety
+/// `at..at + bytes.len()` is mapped code no thread is running.
+unsafe fn write_code(at: usize, bytes: &[u8]) -> Result<()> {
+    let mut old = 0;
+    // SAFETY: the caller's range.
+    if unsafe { VirtualProtect(at as _, bytes.len(), PAGE_EXECUTE_READWRITE, &mut old) } == 0 {
+        bail!("VirtualProtect(code) failed: {}", std::io::Error::last_os_error());
+    }
+    // SAFETY: writable now; see the caller's promise.
+    unsafe {
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), at as *mut u8, bytes.len());
+        VirtualProtect(at as _, bytes.len(), old, &mut old);
+        FlushInstructionCache(GetCurrentProcess(), at as _, bytes.len());
+    }
+    Ok(())
+}
+
+fn rel32(from_end: usize, to: usize) -> Result<[u8; 4]> {
+    let rel = to as i64 - from_end as i64;
+    match i32::try_from(rel) {
+        Ok(r) => Ok(r.to_le_bytes()),
+        Err(_) => bail!("hook thunk out of rel32 reach"),
+    }
+}
+
+/// Redirects the `call target` at `site` to a thunk that runs `before`,
+/// then `target`. Refuses (and changes nothing) unless the 5 bytes there
+/// are that call.
+///
+/// # Safety
+/// `site` is mapped title code that no thread runs yet.
+pub unsafe fn redirect_call(site: usize, target: usize, before: Before) -> Result<()> {
+    // SAFETY: the caller's mapped code.
+    let found = unsafe { std::slice::from_raw_parts(site as *const u8, 5) };
+    if !is_call_to(found, site, target) {
+        bail!("bytes at {site:#x} are {found:02x?}, not a call to {target:#x}");
+    }
+    let thunk = place(site, &before_thunk(before as usize, &[], target))?;
+    let mut call = vec![0xE8];
+    call.extend(rel32(site + 5, thunk)?);
+    // SAFETY: the caller's promise.
+    unsafe { write_code(site, &call) }
+}
+
+/// Turns the function entry at `entry`, whose first bytes must be
+/// `prologue` (whole instructions, position independent, at least 5
+/// bytes), into a jump to a thunk that runs `before`, then the prologue,
+/// then the function from `entry + prologue.len()`. Refuses (and changes
+/// nothing) if the bytes differ.
+///
+/// # Safety
+/// `entry` is mapped title code that no thread runs yet, and no code jumps
+/// into the middle of the prologue.
+pub unsafe fn hook_entry(entry: usize, prologue: &[u8], before: Before) -> Result<()> {
+    if prologue.len() < 5 {
+        bail!("a prologue of {} bytes has no room for a jump", prologue.len());
+    }
+    // SAFETY: the caller's mapped code.
+    let found = unsafe { std::slice::from_raw_parts(entry as *const u8, prologue.len()) };
+    if found != prologue {
+        bail!("bytes at {entry:#x} are {found:02x?}, expected {prologue:02x?}");
+    }
+    let thunk = place(entry, &before_thunk(before as usize, prologue, entry + prologue.len()))?;
+    let mut jump = vec![0xE9];
+    jump.extend(rel32(entry + 5, thunk)?);
+    jump.resize(prologue.len(), 0x90);
+    // SAFETY: the caller's promise.
+    unsafe { write_code(entry, &jump) }
+}
+
+/// The address of a stub that calls `after` (see the module); one per
+/// routine, made once.
+pub fn after_stub(after: After) -> Result<usize> {
+    static MADE: std::sync::Mutex<Vec<(usize, usize)>> = std::sync::Mutex::new(Vec::new());
+    static NEAR: AtomicUsize = AtomicUsize::new(0);
+    let mut made = MADE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(&(_, stub)) = made.iter().find(|m| m.0 == after as usize) {
+        return Ok(stub);
+    }
+    // Anywhere does: the stub is reached by a return, not a rel32.
+    let near_to = match NEAR.load(Ordering::Relaxed) {
+        0 => after as usize,
+        n => n,
+    };
+    let stub = place(near_to, &after_code(after as usize))?;
+    NEAR.store(stub, Ordering::Relaxed);
+    made.push((after as usize, stub));
+    Ok(stub)
+}
